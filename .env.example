# Your ModelRunner API key. Profile -> Keys in the dashboard.
#
# MODELRUNNER_KEY is the canonical spelling and covers both clients: modelrunner-ai
# (Python) reads it, and @modelrunner/client (JavaScript) reads it too, falling back to
# MODEL_RUNNER_KEY -- with the extra underscore -- only when it is unset. Verified in
# @modelrunner/client 1.2.2, the version this repo pins. Older 1.2.x releases may still
# read MODEL_RUNNER_KEY exclusively, so uncomment the second line if you see a 401.
MODELRUNNER_KEY=your_modelrunner_api_key_here
# MODEL_RUNNER_KEY=your_modelrunner_api_key_here

# --- Only needed by the webhook receiver -------------------------------------

# Signing secret for verifying webhook deliveries. Fetch it once and cache it:
#   curl -H "Authorization: Key $MODELRUNNER_KEY" \
#     https://modelrunner.run/webhooks/default/secret
# It is per-account, not per-request. Do not fetch it on every delivery.
MODELRUNNER_WEBHOOK_SECRET=whsec_your_signing_secret_here

# The public HTTPS URL your receiver is reachable at. In local development this
# is a tunnel (cloudflared / ngrok / localtunnel) pointing at your receiver's port.
# Must be HTTPS on a publicly resolvable host, and must be the FINAL url --
# redirects are never followed.
PUBLIC_WEBHOOK_URL=https://your-tunnel.example.com/webhooks/modelrunner

# --- SDK version floors ------------------------------------------------------
# Webhooks require @modelrunner/client >= 1.2.0 and modelrunner-ai >= 0.3.0.
# Older versions accept a webhook URL and silently drop it: the request
# succeeds and the callback never arrives.
